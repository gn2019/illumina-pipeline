// ==========================================
// nextflow.config
// ==========================================

params {
    // home cannot be replaced by $HOME or ~, because they are resolved (sometimes incorrectly) not in runtime.
    home   = "${System.getenv('HOME')}"
    base   = "${params.home}/illumina-pipeline"

    // 1. Target Samples
    tumors  = "PD29429h_DM3_40,PD29429i_DM3_640"
    normal  = "HELA"

    // 2. Base Directories
    scripts   = "${params.base}/scripts"
    results   = "${params.base}/results"
    refs      = "${params.base}/refs"
    fastq_dir = "${params.base}/data/fastq" // Directory to scan for FASTQs

    // 3. Core References
    genome    = "${params.base}/data/genome/hg38/GRCh38.p7.genome.fa"

    // 4. ASCAT, CaVEMan & AmpliconSuite Specific Parameters
    species  = "Human"
    assembly = "GRCh38"
    ascat_gc_correction = "${params.refs}/hg38/CNV_SV_ref_GRCh38_hla_decoy_ebv_brass6+/ascat/SnpGcCorrections.tsv"

    // Optional ASCAT purity/ploidy overrides (-pu/-pi). Only applied when
    // BOTH are set - leave unset to let ascat.pl estimate them itself.
    ascat_purity = null
    ascat_ploidy = null

    // Feed ASCAT's copy-number output into CaVEMan (-tc/-nc/-k) instead of
    // the flat -td 5 -nd 2 defaults. Set to false to always use -td/-nd.
    // Even when true, a pair automatically falls back to -td/-nd if ASCAT's
    // per-sample outputs are missing or unusable.
    follow_ascat_caveman_flow = true

    caveman_blacklist = "${params.refs}/hg38/caveman_blacklist.bed"
    caveman_indels    = "${params.refs}/hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"

    // Data repository for AmpliconSuite references
    ampsuite_data_repo = "${params.refs}/data_repo"

    // 5. Environments & Containers
    conda_envs   = "${params.home}/.conda/envs"
    lumpy_env    = "${params.conda_envs}/lumpy-sv"
    ampsuite_env = "${params.conda_envs}/ampsuite"
    bw_env       = "${params.conda_envs}/bw"
    cgpwgs_sif   = "${params.base}/cgpwgs.sif"

    // 6. Step toggles - turn any of these off to skip that step entirely.
    // All default to false (nothing skipped). ARCHIVE is skipped
    // automatically if any of skip_lumpy/skip_coverage/skip_ascat/
    // skip_caveman is set, since it needs all of their outputs.
    skip_lumpy             = false
    skip_stats             = false
    skip_ampliconarchitect = false
    skip_coverage          = false
    skip_gatk              = false
    skip_ascat             = false
    skip_caveman           = false
    skip_archive           = false

    // 7. LSF preemption workaround.
    // WEXAC's `short` queue preempts jobs often. LSF auto-resumes preempted
    // (Re-runnable) jobs under the same job ID/work dir, but the preemption
    // signal (exit 130) hits Nextflow's wrapper first, which writes
    // .exitcode=130 and triggers errorStrategy=retry - spawning a redundant
    // second task while the original keeps running. Net effect: two
    // full-size LSF allocations for one output.
    //
    // Inserted via beforeScript into every .command.run, this redefines
    // on_exit() so a 130 exit is never written to .exitcode. Nextflow only
    // fails a task once .exitcode is missing AND the job is inactive in
    // `bjobs` - so it just waits out the LSF resume instead of retrying.
    // Verified against Nextflow 25.10.4's LSF executor source.
    nxf_patch_130 = '''eval "$(declare -f on_exit | sed 's|printf -- $exit_status|[[ $exit_status -ne 130 ]] \\&\\& &|')"
'''
}

// lsf and resources
process {
    executor = 'lsf'
    queue    = 'short'

    // needed for preempted jobs not to crash after they return to run.
    clusterOptions = '-R "select[model=AMD_EPYC]"'

    // job defaults
    cpus   = 8
    memory = '48 GB'
    time   = '24h'

    // memory failures retrial strategy
    errorStrategy = 'retry'
    // Replace the above with the following if you want the jobs to finish at another job's error.
    // errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'finish' }  // not yet
    maxRetries    = 3

    // applies to every process below that doesn't declare its own
    // beforeScript (those instead append params.nxf_patch_130 directly,
    // since script-level beforeScript overrides this default rather than
    // merging with it - see main.nf: RUN_LUMPY, RUN_STATS, RUN_AMPLICONARCHITECT, ARCHIVE)
    beforeScript = params.nxf_patch_130

    // lite jobs
    withName: 'GENERATE_BAMS_LIST|PREPARE_BEDS|SPLIT_BED_INTO_CHUNKS' {
        cpus   = 1
        memory = '1 GB'
        time   = '1h'
    }
}

// conda and singularity
conda {
    enabled = true
}

singularity {
    enabled    = true
    autoMounts = true
}

timeline {
    enabled = true
    overwrite = true
}

cleanup = true
