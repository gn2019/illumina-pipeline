// ==========================================
// nextflow.config
// ==========================================

params {
    base   = "$HOME/illumina-pipeline"

    // 1. Target Samples (Override these via command line)
    tumors  = "PD29429h_DM3_40,PD29429i_DM3_640"
    normal  = "HELA"

    // 2. Base Directories
    scripts   = "${params.base}/scripts"
    results   = "${params.base}/results"
    refs      = "${params.base}/refs"
    fastq_dir = "${params.base}/data/fastq" // Directory to scan for FASTQs

    // 3. Core References
    genome    = "${params.base}/data/genome/hg38/GRCh38.p7.genome.fa"

    // 4. ASCAT & CaVEMan Specific Parameters
    species  = "Human"
    assembly = "GRCh38"
    ascat_gc_correction = "${params.refs}/hg38/CNV_SV_ref_GRCh38_hla_decoy_ebv_brass6+/ascat/SnpGcCorrections.tsv"

    // Optional ASCAT purity/ploidy overrides (-pu/-pi). Only applied when
    // BOTH are set - leave unset to let ascat.pl estimate them itself.
    ascat_purity = null
    ascat_ploidy = null

    // Feed ASCAT's copy-number output into CaVEMan (-tc/-nc/-k) instead of
    // the flat -td 5 -nd 2 defaults. Set to false to always use -td/-nd.
    // Even when true, a pair automatically falls back to -td/-nd if ASCAT's
    // per-sample outputs are missing or unusable.
    follow_ascat_caveman_flow = true

    caveman_blacklist = "${params.refs}/hg38/caveman_blacklist.bed"
    caveman_indels    = "${params.refs}/hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"

    // 5. Environments & Containers
    lumpy_env    = "$HOME/.conda/envs/lumpy-sv"
    ampsuite_env = "$HOME/.conda/envs/ampsuite"
    bw_env       = "$HOME/.conda/envs/bw"
    cgpwgs_sif   = "${params.base}/cgpwgs.sif"

    // 6. Step toggles - turn any of these off to skip that step entirely.
    // All default to false (nothing skipped). ARCHIVE is skipped
    // automatically if any of skip_lumpy/skip_coverage/skip_ascat/
    // skip_caveman is set, since it needs all of their outputs.
    skip_lumpy             = false
    skip_stats             = false
    skip_ampliconarchitect = false
    skip_coverage          = false
    skip_gatk              = false
    skip_ascat             = false
    skip_caveman           = false
    skip_archive           = false
}

// lsf and resources
process {
    executor = 'lsf'
    queue    = 'short'

    clusterOptions = '-R "select[model=AMD_EPYC]"'
    // errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'finish' }  // not yet

    // job defaults
    cpus   = 8
    memory = '48 GB'
    time   = '24h'

    // memory failures retrial strategy
    errorStrategy = 'retry'
    maxRetries    = 3

    // lite jobs
    withName: 'GENERATE_BAMS_LIST|PREPARE_BEDS|SPLIT_BED_INTO_CHUNKS' {
        cpus   = 1
        memory = '1 GB'
        time   = '1h'
    }
}

// conda and singularity
conda {
    enabled = true
}

singularity {
    enabled    = true
    autoMounts = true
}

timeline {
    enabled = true
    overwrite = true
}
